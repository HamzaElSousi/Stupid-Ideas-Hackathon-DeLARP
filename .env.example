# AI investigator: Gemini runs first, Claude takes over if Gemini is missing or fails.
# With neither key, DeLARP runs in "vibes mode" with fake verdicts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Persistent LARP List. On Vercel: Storage -> add Upstash Redis, it injects these.
# Without them the list lives in memory and resets when the server sleeps.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work)

# Optional: send the stupid metrics to Amplitude (Stupidest Metric prize)
AMPLITUDE_API_KEY=
