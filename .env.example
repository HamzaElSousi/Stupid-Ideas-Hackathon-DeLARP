# Required for the real AI agent. Without it, DeLARP runs in "vibes mode" with fake verdicts.
ANTHROPIC_API_KEY=

# Optional: which Claude model runs the investigation (must support web search + images)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: persistent LARP List. On Vercel: Storage -> add Upstash Redis, it injects these.
# Without them the list lives in memory and resets when the server sleeps.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# (UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN also work)

# Optional: send the stupid metrics to Amplitude (Stupidest Metric prize)
AMPLITUDE_API_KEY=
